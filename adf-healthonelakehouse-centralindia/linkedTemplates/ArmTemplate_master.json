{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-healthonelakehouse-centralindia"
		},
		"GenericAzureDataLakeStorage_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().StorageAccountName}"
		},
		"GenericAzure_LS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "@{linkedService().ServerName}"
		},
		"GenericAzure_LS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().DatabaseName}"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-healthonelakehouse-centralindia_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"GenericAzureDataLakeStorage_LS_properties_typeProperties_url": {
						"value": "[parameters('GenericAzureDataLakeStorage_LS_properties_typeProperties_url')]"
					},
					"GenericAzure_LS_properties_typeProperties_server": {
						"value": "[parameters('GenericAzure_LS_properties_typeProperties_server')]"
					},
					"GenericAzure_LS_properties_typeProperties_database": {
						"value": "[parameters('GenericAzure_LS_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}